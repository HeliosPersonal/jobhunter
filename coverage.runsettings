<?xml version="1.0" encoding="utf-8"?>
<!-- Coverage collection for CI (ci-cd §2). This file only shapes what the XPlat Code Coverage collector
     gathers. The > 90% line+branch gate is enforced by the "Enforce coverage gate" step in the workflow,
     which merges the per-assembly reports and fails the build below threshold — the collector itself does
     not read the Coverlet MSBuild <Threshold> in tests/Directory.Build.props (that only applies to a
     Coverlet-MSBuild `dotnet test /p:CollectCoverage=true` run, which CI does not use). -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <ExcludeByAttribute>ExcludeFromCodeCoverageAttribute,GeneratedCodeAttribute</ExcludeByAttribute>
          <ExcludeByFile>**/Migrations/*.cs</ExcludeByFile>
          <Exclude>[JobHunter.AppHost]*,[JobHunter.ServiceDefaults]*,[JobHunter.Contracts]*,[JobHunter.TestKit]*</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
